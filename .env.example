# Copy this file to ".env" (same folder) and fill it in. ".env" is git-ignored.

# YouTube Data API v3 key, used by the Search button.
# Get one: https://console.cloud.google.com/  ->  APIs & Services  ->  Library
#          -> "YouTube Data API v3" -> Enable  ->  Credentials  ->  Create API key
# Leave it empty and search still works, using yt-dlp's built-in YouTube search.
YOUTUBE_API_KEY=your_api_key_here

# Port for the local server (npm start)
PORT=3000

# Only needed if yt-dlp is not on your PATH, e.g. C:\Tools\yt-dlp.exe
YT_DLP_PATH=yt-dlp
